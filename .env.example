# Supabase project URL — Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key — Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — used server-side only (quote/order API routes, WhatsApp
# webhook) to bypass RLS where the caller has no user session. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# The deployed site's canonical URL, e.g. https://brickcase.vercel.app
# Used to build the checkout deep-links the WhatsApp bot sends back to users.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brickset API key (https://brickset.com/tools/webservices/requestkey) — optional.
# Enables exact built-model dimensions for LEGO sets. Without it, the LEGO dimension
# resolver falls back to a piece-count/theme heuristic estimate (clearly labeled as such).
BRICKSET_API_KEY=

# Rebrickable API key (https://rebrickable.com/api/) — optional. Used to fetch set
# name/piece-count/image metadata that feeds the heuristic estimator.
REBRICKABLE_API_KEY=

# Shared secret the WhatsApp simulator UI (/dev/wa-sim) and a future real provider
# webhook must present to POST /api/whatsapp/webhook. Any non-empty value works in
# development; set a strong random value in production.
WHATSAPP_WEBHOOK_SECRET=dev-secret

# BrickLink API credentials (https://www.bricklink.com/v2/api/register_consumer.page)
# — optional. All four are required together; with any missing, the BrickLink
# resolver tier is skipped entirely. BrickLink records *packaging* dimensions
# rather than built-model dimensions, so results from this tier are always
# labeled "estimated" — Brickset (BRICKSET_API_KEY above) is still preferred
# when it has the set on file.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=

# Where "Request a Custom Engineered Quote" sends customers whose box is too
# large for an automated quote (over pricing_config.max_dim_mm). Set at least
# one; WhatsApp is preferred when both are present. Without either, the
# calculator shows the custom-quote message with no button to act on.
# Digits only, country code first, e.g. 972501234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
