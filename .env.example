# Supabase project URL — Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key — Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The deployed site's canonical URL, e.g. https://woodmarketplace.vercel.app
NEXT_PUBLIC_SITE_URL=
